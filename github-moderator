import os

def main():
    # 1. GitHub сам передаст текст комментария в эту переменную среды
    comment_text = os.getenv("COMMENT_BODY", "").lower()
    
    # 2. Наш список запрещенных слов
    bad_words = ["stupid", "idiot", "trash", "garbage", "hate"]
    
    # 3. Проверяем текст
    for word in bad_words:
        if word in comment_text:
            print(f"🚨 ОБНАРУЖЕН ТОКСИЧНЫЙ КОММЕНТАРИЙ! Найдено слово: '{word}'")
            # Вызываем ошибку, чтобы GitHub пометил этот комментарий красным крестиком
            exit(1) 
            
    print("🟢 Проверка пройдена. Комментарий вежливый!")

if __name__ == "__main__":
    main()
